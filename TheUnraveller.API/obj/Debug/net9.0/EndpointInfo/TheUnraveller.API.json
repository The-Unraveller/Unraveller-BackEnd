{
  "openapi": "3.0.1",
  "info": {
    "title": "TheUnraveller.API",
    "version": "1.0"
  },
  "paths": {
    "/api/Game/message": {
      "post": {
        "tags": [
          "Game"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DialogueRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/DialogueRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/DialogueRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DialogueResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialogueResponseDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DialogueResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/Mission": {
      "get": {
        "tags": [
          "Mission"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MissionDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MissionDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MissionDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Mission/{id}": {
      "get": {
        "tags": [
          "Mission"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/MissionDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/MissionDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DialogueRequestDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "missionId": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DialogueResponseDto": {
        "type": "object",
        "properties": {
          "npcResponse": {
            "type": "string",
            "nullable": true
          },
          "feedback": {
            "type": "string",
            "nullable": true
          },
          "newSuspicionLevel": {
            "type": "integer",
            "format": "int32"
          },
          "isWin": {
            "type": "boolean"
          },
          "isLose": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "MissionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "goal": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "startSuspicion": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  }
}